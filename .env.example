# ──────────────────────────────────────────────────────────────────────────
# Root level (consumed by docker-compose)
# ──────────────────────────────────────────────────────────────────────────

# Domains
APP_DOMAIN=dashboard.localhost
API_DOMAIN=api.localhost
TRAEFIK_DOMAIN=traefik.localhost
ACME_EMAIL=admin@example.com

# Database
POSTGRES_USER=nginx_dashboard
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=nginx_dashboard

# Traefik dashboard basic auth (htpasswd format, $ must be escaped as $$)
TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$abcd$$x.y.z.w
