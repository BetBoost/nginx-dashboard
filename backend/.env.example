# ── App ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173

# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://nginx_dashboard:change_me@postgres:5432/nginx_dashboard?schema=public

# ── Security ──────────────────────────────────────────────────────────────
# >= 32 random bytes (base64).  Used to encrypt SSH keys at rest.
ENCRYPTION_KEY=replace_me_with_32_bytes_base64_value=
JWT_ACCESS_SECRET=replace_me_long_random_value
JWT_REFRESH_SECRET=replace_me_another_long_random_value
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── First admin (created on first boot if not exists) ─────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMeNow!

# ── Rate limit ────────────────────────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ── CORS ──────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,https://dashboard.localhost
